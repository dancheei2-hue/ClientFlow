{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "clientflow",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "TELEGRAM_SESSION",
        "class_name": "TelegramSession"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TelegramSession"
      ]
    }
  ]
}
