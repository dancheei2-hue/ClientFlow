# Telegram API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash

# OpenAI API key
OPENAI_API_KEY=your_openai_api_key

# Model used for replies
OPENAI_MODEL=gpt-5-mini

# Basic assistant instructions
ASSISTANT_NAME=AI-ассистент
ASSISTANT_INSTRUCTIONS=Ты вежливый помощник. Отвечай естественно, коротко и по делу. Не выдумывай факты. Если не знаешь ответа, скажи, что передашь вопрос владельцу.
